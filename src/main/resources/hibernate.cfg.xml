<hibernate-configuration>
    <session-factory>

        <property name="hibernate.connection.driver_class">com.p6spy.engine.spy.P6SpyDriver</property>
        <property name="hibernate.connection.url">jdbc:p6spy:mysql://localhost:3306/movie</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">Password1.</property>

        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.use_sql_comments">true</property>

        <property name="hibernate.hbm2ddl.auto">none</property>

        <mapping class="org.example.movie.entity.Actor"/>
        <mapping class="org.example.movie.entity.Category"/>
        <mapping class="org.example.movie.entity.Film"/>
        <mapping class="org.example.movie.entity.FilmText"/>
        <mapping class="org.example.movie.entity.Language"/>
        <mapping class="org.example.movie.entity.Country"/>
        <mapping class="org.example.movie.entity.City"/>
        <mapping class="org.example.movie.entity.Address"/>
        <mapping class="org.example.movie.entity.Store"/>
        <mapping class="org.example.movie.entity.Customer"/>
        <mapping class="org.example.movie.entity.Rental"/>
        <mapping class="org.example.movie.entity.Inventory"/>
        <mapping class="org.example.movie.entity.Staff"/>
        <mapping class="org.example.movie.entity.Payment"/>

    </session-factory>
</hibernate-configuration>
